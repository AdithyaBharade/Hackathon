PORT=8000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Postgres + Redis from `docker compose up postgres redis` (host ports 5433 / 6380)
DATABASE_URL="postgresql://certiflow:certiflow@localhost:5433/certiflow"
# Used by the Prisma CLI for migrations
DIRECT_URL="postgresql://certiflow:certiflow@localhost:5433/certiflow"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
# lax works for localhost:5173 -> :8000. Use "none" (+ HTTPS) if FE and API are on different sites in prod
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
REDIS_URL=redis://localhost:6380
LOG_LEVEL=debug

# --- CertiFlow ---
# HMAC secret for candidate download links (openssl rand -hex 32)
CERT_LINK_SECRET=change-me-to-another-long-random-string
PUBLIC_API_URL=http://localhost:8000/api
PUBLIC_WEB_URL=http://localhost:5173
STORAGE_DIR=./storage
# Stand-in WhatsApp provider (npm run dev:whatsapp, or the whatsapp-mock container)
WHATSAPP_API_URL=http://localhost:8100
WHATSAPP_TIMEOUT_MS=3000
WHATSAPP_MAX_ATTEMPTS=8
WHATSAPP_RETRY_BASE_MS=2000
WHATSAPP_RETRY_MAX_MS=300000
WORKER_CONCURRENCY=10
DISTRICT_QUORUM=2
BIG_BATCH_THRESHOLD=50
# Demo: escalate after 2 minutes (production: 2880 = 48h)
STUCK_AFTER_MINUTES=2
STUCK_CHECK_EVERY_SECONDS=15
