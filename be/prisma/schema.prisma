generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// People & organisation
// ---------------------------------------------------------------------------

enum Role {
  CENTRE           // training centre staff
  DISTRICT_OFFICER // reviews batches from centres in their district
  QUALITY          // extra scrutiny for large batches
  STATE            // final approval, revocation, escalations
}

model District {
  id        String           @id @default(uuid())
  code      String           @unique
  name      String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  centres   TrainingCentre[]
  users     User[]
  batches   Batch[]

  @@map("districts")
}

model TrainingCentre {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  users      User[]
  batches    Batch[]

  @@index([districtId])
  @@map("training_centres")
}

model User {
  id            String          @id @default(uuid())
  name          String
  email         String          @unique
  password      String
  role          Role
  /// Set for DISTRICT_OFFICER (and CENTRE users, derived from their centre)
  districtId    String?
  district      District?       @relation(fields: [districtId], references: [id])
  /// Set for CENTRE users only
  centreId      String?
  centre        TrainingCentre? @relation(fields: [centreId], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  refreshTokens RefreshToken[]
  decisions     Decision[]

  @@index([createdAt])
  @@index([districtId])
  @@index([centreId])
  @@map("users")
}

/// Only the SHA-256 hash of the refresh token is stored.
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Batches & approvals
// ---------------------------------------------------------------------------

enum BatchStatus {
  DRAFT
  PENDING_DISTRICT
  PENDING_QUALITY
  PENDING_STATE
  SENT_BACK
  REJECTED
  APPROVED
}

enum Stage {
  DISTRICT
  QUALITY
  STATE
}

enum DecisionAction {
  APPROVE
  REJECT
  SEND_BACK
}

model Batch {
  id             String         @id @default(uuid())
  code           String         @unique
  courseName     String
  trainingEndDate DateTime      @db.Date
  centreId       String
  centre         TrainingCentre @relation(fields: [centreId], references: [id])
  /// Copied from the centre so district scoping is a single indexed filter
  districtId     String
  district       District       @relation(fields: [districtId], references: [id])
  status         BatchStatus    @default(DRAFT)
  /// Bumped on every (re)submission. Decisions belong to one version.
  version        Int            @default(0)
  candidateCount Int            @default(0)
  /// When the batch entered its current stage (drives the stuck-batch SLA)
  stageEnteredAt DateTime?
  /// Set once the current stage has been escalated as stuck; cleared on every stage change
  escalatedAt    DateTime?
  lastReason     String?
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  candidates     Candidate[]
  decisions      Decision[]
  certificates   Certificate[]

  @@index([centreId, status])
  @@index([districtId, status])
  @@index([status, stageEnteredAt])
  @@map("batches")
}

model Candidate {
  id           String       @id @default(uuid())
  batchId      String
  batch        Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber    Int
  name         String
  mobile       String
  dateOfBirth  DateTime     @db.Date
  grade        String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  certificate  Certificate?

  /// One person appears once per batch
  @@unique([batchId, mobile])
  @@index([mobile])
  @@map("candidates")
}

/// One row per officer per stage per batch version. The unique key stops one
/// officer counting twice towards the quorum.
model Decision {
  id           String         @id @default(uuid())
  batchId      String
  batch        Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchVersion Int
  stage        Stage
  action       DecisionAction
  reason       String?
  actorId      String
  actor        User           @relation(fields: [actorId], references: [id])
  /// An officer may withdraw their approval while the stage is still open
  retractedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([batchId, batchVersion, stage, actorId])
  @@index([batchId])
  @@index([actorId])
  @@map("decisions")
}

// ---------------------------------------------------------------------------
// Certificates & delivery
// ---------------------------------------------------------------------------

enum CertificateStatus {
  ISSUED
  REVOKED
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

model Certificate {
  id             String            @id @default(uuid())
  /// Human-facing number, e.g. PSM-2026-000123. Generated by a DB sequence.
  number         String            @unique @default(dbgenerated("('PSM-' || to_char(now(), 'YYYY') || '-' || lpad(nextval('certificate_number_seq')::text, 6, '0'))"))
  /// Unique: a candidate can never hold two certificates
  candidateId    String            @unique
  candidate      Candidate         @relation(fields: [candidateId], references: [id])
  batchId        String
  batch          Batch             @relation(fields: [batchId], references: [id])
  status         CertificateStatus @default(ISSUED)
  pdfPath        String?
  issuedAt       DateTime          @default(now())
  revokedAt      DateTime?
  revokedById    String?
  revokeReason   String?
  deliveryStatus DeliveryStatus    @default(PENDING)
  deliveryAttempts Int             @default(0)
  providerMessageId String?
  lastDeliveryError String?
  deliveredAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([batchId])
  @@index([deliveryStatus])
  @@map("certificates")
}

// ---------------------------------------------------------------------------
// Events, audit, notifications
// ---------------------------------------------------------------------------

/// Transactional outbox: written in the same transaction as the state change,
/// relayed to the queue by the worker. A crash between commit and enqueue
/// can therefore never lose an event.
model OutboxEvent {
  id          String    @id @default(uuid())
  type        String
  payload     Json
  publishedAt DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

/// Append-only trail of everything that happened to a batch or certificate.
model AuditEvent {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  batchId    String?
  action     String
  actorId    String?
  actorRole  String?
  requestId  String?
  data       Json?
  createdAt  DateTime @default(now())

  @@index([batchId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("audit_events")
}

model Notification {
  id        String    @id @default(uuid())
  /// Recipients by role (and optionally district); null district = all
  role      Role
  districtId String?
  batchId   String?
  type      String
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([role, createdAt])
  @@map("notifications")
}
